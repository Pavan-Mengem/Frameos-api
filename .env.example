# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=frameos_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_AUTO_SYNC=true                 # dev only; set false once migrations are the source of truth

# --- JWT — generate with: openssl rand -base64 32 ---
JWT_ACCESS_SECRET='#ma1230sjak20d2910dn233sjw'
JWT_REFRESH_SECRET='#ma1230sjak20d2910dn233sjw'
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- OTPless (login) — otpless.com → Integrations → API Keys ---
OTPLESS_CLIENT_ID=
OTPLESS_CLIENT_SECRET=

# --- S3 (galleries) — bucket in ap-south-1 for data residency ---
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=               # CDN base (e.g. https://cdn.frameos.app); blank = s3 direct
S3_PRESIGN_EXPIRES=900

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
